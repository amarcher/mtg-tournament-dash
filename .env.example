# Provision via: vercel link && vercel install neon && vercel env pull .env.local
DATABASE_URL=

# Used to sign player join cookies. Generate with: openssl rand -hex 32
COOKIE_SECRET=

# Push notifications (native shell only). All optional: unset, sends are
# logged as failed with a *_not_configured reason. See docs/push-setup.md.
APNS_KEY_ID=
APNS_TEAM_ID=
APNS_P8=
# APNS_BUNDLE_ID=com.capxun.mtgdash
# APNS_SANDBOX=1   # only for an Xcode-run development build
FCM_SERVICE_ACCOUNT=
